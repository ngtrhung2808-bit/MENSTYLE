# ========================================================
# MENSTYLE Environment Configuration Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/menstyle_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/menstyle_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/menstyle_db

# Security & Authentication
JWT_SECRET=menstyle_super_secret_jwt_key_2026_fashion_stylist
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend Vite API Base URL (optional override)
VITE_API_BASE_URL=http://localhost:5000/api
