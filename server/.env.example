PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/menstyle_db
# Generate a unique random value with at least 32 characters and keep it in ignored server/.env.
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# These are used only when the seeder creates the demo accounts for the first time.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
